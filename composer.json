{
    "name": "t3planet/rte-ckeditor-pack",
    "type": "typo3-cms-extension",
    "description": "CKEditor Pack - CKEditor Pack TYPO3 extension provides a modern, integrated CKEditor build many optimized features, accessibility tools, AI assistance, and collaboration-friendly options—all without managing scattered YAML files. Built for stability and clean integration, it streamlines editing workflows and enhances TYPO3 content quality.",
    "homepage": "https://t3planet.de/ckeditor-pack",
    "authors": [
        {
            "name": "Team T3Planet"
        }
    ],
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "CKEditor",
        "RTE",
        "AI"
    ],
    "support": {
        "issues": "https://github.com/T3Planet/rte_ckeditor_pack/issues"
    },
    "require": {
        "php": ">=8.1.0 <=8.5.99",
        "typo3/cms-core": ">= 12.4.25 || ^13.4 || ^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89.2",
        "phpstan/phpdoc-parser": "^2.3.3",
        "phpunit/phpunit": "^10.5.58",
        "typo3/coding-standards": "^0.9.0",
        "typo3/testing-framework": "^8.3.1"
    },
    "autoload": {
        "psr-4": {
            "T3Planet\\RteCkeditorPack\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "T3Planet\\RteCkeditorPack\\Tests\\": "Tests"
        }
    },
    "replace": {
        "typo3-ter/rte-ckeditor-pack": "self.version"
    },
    "config": {
        "allow-plugins": {
            "a9f/fractor-extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "lock": false,
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "app-dir": ".Build",
            "web-dir": ".Build/public",
            "extension-key": "rte_ckeditor_pack"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "TYPO3\\TestingFramework\\Composer\\ExtensionTestEnvironment::prepare"
        ],
        "test": "@test:unit",
        "test:unit": "Build/Scripts/runTests.sh -t 13 -p 8.4 -s unit",
        "test:unit:v12": "Build/Scripts/runTests.sh -t 12 -p 8.2 -s unit",
        "test:unit:v13": "Build/Scripts/runTests.sh -t 13 -p 8.4 -s unit",
        "test:unit:v14": "Build/Scripts/runTests.sh -t 14 -p 8.4 -s unit",
        "test:functional": "Build/Scripts/runTests.sh -t 13 -p 8.4 -d sqlite -s functional",
        "test:all": [
            "@test:unit",
            "@test:functional"
        ],
        "test:unit:matrix": [
            "@test:unit:v12",
            "@test:unit:v13",
            "@test:unit:v14"
        ],
        "doc-init": "docker run --rm --pull always -v $(pwd):/project -it ghcr.io/typo3-documentation/render-guides:latest --config=Documentation",
        "doc-make": "make docs",
        "doc-watch": "docker run --rm -it --pull always \\\n  -v \"./Documentation:/project/Documentation\" \\\n  -v \"./Documentation-GENERATED-temp:/project/Documentation-GENERATED-temp\" \\\n  -p 5173:5173 ghcr.io/garvinhicking/typo3-documentation-browsersync:latest\nopen \"http://localhost:5173/Documentation-GENERATED-temp/Index.html\"",
        "cs": "PHP_CS_FIXER_IGNORE_ENV=1 php ./.Build/bin/php-cs-fixer fix --dry-run -v --config ./Build/php-cs-fixer/php-cs-fixer.php ./",
        "csfix": "PHP_CS_FIXER_IGNORE_ENV=1 php ./.Build/bin/php-cs-fixer fix -v --config ./Build/php-cs-fixer/php-cs-fixer.php ./"
    },
    "scripts-descriptions": {
      "test": "Run unit tests in the containerized runTests setup (alias for test:unit)",
      "test:unit": "Run unit tests via Build/Scripts/runTests.sh",
      "test:functional": "Run functional tests via Build/Scripts/runTests.sh with sqlite",
      "test:all": "Run all tests (unit + functional) via Build/Scripts/runTests.sh",
      "doc-init": "Initialize documentation rendering",
      "doc-make": "Render documentation",
      "doc-watch": "Render documentation including a watcher"
    }
}
