## TS setup for TYPO3 image rendering

#******************************************************
# Including library for processing of magic images and file abstraction attributes on img tag
#******************************************************

lib.parseFunc_RTE {
    tags.img = TEXT
    tags.img {
        current = 1
        preUserFunc = T3Planet\RteCkeditorPack\Controller\ImageRenderingController->renderImageAttributes
    }
    tags.a = TEXT
    tags.a {
        current = 1
        preUserFunc = T3Planet\RteCkeditorPack\Controller\ImageLinkRenderingController->renderImages
    }
    nonTypoTagStdWrap.HTMLparser.tags.img.fixAttrib {
        allparams.unset = 1
        data-htmlarea-file-uid.unset = 1
        data-htmlarea-file-table.unset = 1
        data-htmlarea-zoom.unset = 1
        data-htmlarea-clickenlarge.unset = 1
        data-title-override.unset = 1
        data-alt-override.unset = 1
    }
}

lib.parseFunc_RTE.nonTypoTagStdWrap.encapsLines.encapsTagList := addToList(img,math)

# Keep MathML intact for MathType formulas (frontend MathJax is injected via ParsedHtmlForFrontend)
lib.parseFunc_RTE.allowTags := addToList(math,semantics,annotation,annotation-xml,mrow,mi,mn,mo,ms,mtext,mspace,mfrac,msqrt,mroot,msub,msup,msubsup,munder,mover,munderover,mtable,mtr,mtd,menclose,mstyle,mpadded,mphantom,mfenced,mmultiscripts,mprescripts,none,merror,mglyph,mlabeledtr)
lib.parseFunc.allowTags := addToList(math,semantics,annotation,annotation-xml,mrow,mi,mn,mo,ms,mtext,mspace,mfrac,msqrt,mroot,msub,msup,msubsup,munder,mover,munderover,mtable,mtr,mtd,menclose,mstyle,mpadded,mphantom,mfenced,mmultiscripts,mprescripts,none,merror,mglyph,mlabeledtr)
